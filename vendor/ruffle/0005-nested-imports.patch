+/// A future that yields once to the executor, letting other
+/// spawned futures run before this future is polled again.
+/// Hand-rolled so the loader needs no new dependency on any target
+/// (notably wasm, where the `futures` crate is unavailable): the
+/// waker re-queues this future behind the other ready tasks, which
+/// is exactly how a nested import load gets its turn while
+/// `load_asset_movie` waits for it.
+#[derive(Default)]
+struct YieldOnce(bool);
+
+impl Future for YieldOnce {
+    type Output = ();
+
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        if self.0 {
+            Poll::Ready(())
+        } else {
+            self.0 = true;
+            cx.waker().wake_by_ref();
+            Poll::Pending
+        }
+    }
+}
