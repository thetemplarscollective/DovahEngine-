+    /// namespace for the imported clip. In a valid SWF the ID cannot
+    /// also be one of the clip's own definitions (character IDs are
+    /// unique per movie), so the displaced character is always
+    /// either a copied export or a previous registration of the same
+    /// import. Returns the displaced character, if any.
+    pub fn register_character_overwrite(
+        &mut self,
+        id: CharacterId,
+        character: Character<'gc>,
+    ) -> Option<Character<'gc>> {
+        if let Character::Font(font) = character {
+            self.fonts.register(font);
+        }
+        self.characters.insert(id, character)
+    }
